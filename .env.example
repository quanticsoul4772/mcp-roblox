# Neo4j Configuration (required for AI features)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# Voyage AI Configuration (required for AI features)
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_MODEL=voyage-code-3
VOYAGE_DIMENSIONS=1024

# Roblox Open Cloud
ROBLOX_OPEN_CLOUD_API_KEY=your-roblox-api-key

# TRELLIS Mesh Generation via RunPod (for studio_generate_mesh)
# Get API key at: https://runpod.io/console/user/settings
# Deploy worker from: https://github.com/quanticsoul4772/trellis-runpod-worker
RUNPOD_API_KEY=your-runpod-api-key
TRELLIS_ENDPOINT_ID=your-endpoint-id
# HuggingFace token for model downloads
HF_TOKEN=your-huggingface-token
# Optional overrides:
# RUNPOD_BASE_URL=https://api.runpod.ai/v2
# TRELLIS_MAX_POLL_ATTEMPTS=120  # 120 * 5s = 10 min timeout
# TRELLIS_POLL_INTERVAL_MS=5000  # Poll every 5 seconds

# Server Configuration
ROBLOX_MCP_PORT=8080
RUST_LOG=roblox_studio_mcp=info
